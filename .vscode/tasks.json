{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CP: Compile & Run (Windows)",
      "type": "shell",
      "command": "g++ -O2 -std=c++20 \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\" && Get-Content \"${fileDirname}\\input.txt\" | & \"${fileDirname}\\${fileBasenameNoExtension}.exe\" | Set-Content \"${fileDirname}\\output.txt\"",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}